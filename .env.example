# Copy to .env and set a non-default random token before exposing the service.
AI_BUDDY_PORT=8000
AI_BUDDY_DEVICE_TOKEN=replace-this-before-network-use

# Address visible from the Buddy. Required when reverse-proxied or deployed remotely.
# AI_BUDDY_PUBLIC_BASE_URL=http://192.168.1.4:8000

# Gemma model available in the local Ollama runtime.
AI_BUDDY_AGENT_MODEL=gemma4:e4b
AI_BUDDY_AGENT_PROVIDER=ollama
AI_BUDDY_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Local Whisper STT model. It is downloaded by the backend on its first audio request.
AI_BUDDY_STT_PROVIDER=faster_whisper
AI_BUDDY_STT_MODEL=base
AI_BUDDY_STT_LANGUAGE=es

# Local Piper TTS voice. The first spoken reply downloads the voice once.
AI_BUDDY_TTS_PROVIDER=piper
AI_BUDDY_TTS_VOICE=es_AR-daniela-high
